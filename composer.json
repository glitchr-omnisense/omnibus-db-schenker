{
    "name": "omnibus/db-schenker",
    "type": "library",
    "description": "Omnibus DB Schenker: tracking through the eSchenker API; rates from configuration, shipments booked in the portal.",
    "keywords": [
        "shipping",
        "carrier",
        "omnibus",
        "db schenker"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "omnisense/omnibus": "^2.0@dev",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Omnibus\\DbSchenker\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omnibus\\DbSchenker\\Tests\\": "Tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
